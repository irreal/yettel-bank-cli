{
  "name": "yettel-cli",
  "version": "0.1.0",
  "description": "Owner-authorized personal CLI for Yettel Bank (Serbia) e-banking — QR login + account tooling.",
  "type": "module",
  "bin": {
    "yettel": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "yettel": "tsx src/cli.ts",
    "login": "tsx src/cli.ts login",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
